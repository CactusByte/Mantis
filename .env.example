ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
HEARTBEAT_MINUTES=3
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional manual tool gating:
# - If ENABLED_TOOLS is set, only those tools are exposed.
# - DISABLED_TOOLS always removes tools.
# Tool names: file,http,x_get_mentions,x_create_post
TWITTER_TOOL=true
ENABLED_TOOLS=
DISABLED_TOOLS=

X_BEARER_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=

X_OAUTH2_USER_TOKEN=
X_OAUTH2_REFRESH_TOKEN=
X_OAUTH2_REDIRECT_URI=http://127.0.0.1:8080/callback
X_OAUTH2_SCOPES=tweet.read tweet.write users.read offline.access

X_USER_ID=
MENTIONS_CHECK_MINUTES=3