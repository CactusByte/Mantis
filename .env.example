ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
HEARTBEAT_MINUTES=3
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional manual tool gating:
# - If ENABLED_TOOLS is set, only those tools are exposed.
# - DISABLED_TOOLS always removes tools.
# Tool names: file,http,x_get_mentions,x_create_post,supabase_rest,gmail,google_calendar,
#   telegram_send,firecrawl_scrape,tavily_search,e2b_run,modal_webhook
TWITTER_TOOL=true
ENABLED_TOOLS=
DISABLED_TOOLS=

X_BEARER_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=

X_OAUTH2_USER_TOKEN=
X_OAUTH2_REFRESH_TOKEN=
X_OAUTH2_REDIRECT_URI=http://127.0.0.1:8080/callback
X_OAUTH2_SCOPES=tweet.read tweet.write users.read offline.access

X_USER_ID=
MENTIONS_CHECK_MINUTES=3

# --- Supabase (supabase_rest) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=   # alternative to service role for read-only / RLS-protected use

# --- Google Gmail + Calendar (gmail, google_calendar) — one OAuth refresh token ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Telegram outbound (telegram_send); chat_id optional if set here ---
TELEGRAM_DEFAULT_CHAT_ID=

# --- Firecrawl (firecrawl_scrape) ---
FIRECRAWL_API_KEY=

# --- Tavily (tavily_search) ---
TAVILY_API_KEY=

# --- E2B code execution (e2b_run); dependency in requirements.txt ---
E2B_API_KEY=

# --- Modal or custom HTTPS runner (modal_webhook) ---
MODAL_WEBHOOK_URL=
MODAL_WEBHOOK_BEARER=